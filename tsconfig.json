{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@open-tomato/typescript-config/bun",
  "compilerOptions": {
    // Off: this service never emits declarations, and its exports include
    // Zod schemas and a Drizzle table whose inferred types cannot be written
    // by hand. Follow-up: turn it on if lib/ is ever published as a package.
    "isolatedDeclarations": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "lib", "tools", "tests", "*.ts", "*.mjs"],
  // *.test.ts is excluded from check-types (origin parity — vitest executes
  // them; tsc doesn't gate them). Burning this down is tracked in specs/.
  "exclude": ["node_modules", ".tmp", "dist", ".docs", "**/*.test.ts"]
}
